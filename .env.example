# =============================================================================
# AI Service - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill real values. Do not commit the real .env.
# AI service does not connect to any tenant database; Backend sends embeddings.
# =============================================================================

# App
APP_NAME=AI-Service
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
ACCESS_LOG=False
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8096

# Backend integration
# Must match Backend SECRET_KEY and AI_SERVICE_SECRET.
BACKEND_JWT_SECRET=your-backend-jwt-secret-here
BACKEND_CALLBACK_SECRET=shared-secret-key-for-hmac-verification-change-this

# Model paths
EMBEDDING_DIR=
DETECTOR_CHECKPOINT=/path/to/best_yolov3_widerface.pth
RECOGNIZER_CHECKPOINT=/path/to/model_ir_se50.pth
ANTISPOOFING_CHECKPOINT=/path/to/final_classroom_model3.pth

# GPU
MODEL_DEVICE=cuda
ANTISPOOFING_DEVICE=cuda

# Runtime priority
AI_FACE_WORKERS=4
AI_RAG_WORKERS=1
AI_IO_WORKERS=2
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=16

# Memory optimization
MEMORY_GPU_THRESHOLD=0.85
MEMORY_CLEANUP_INTERVAL=50
MEMORY_MAX_FACES_PER_FRAME=10
MEMORY_MAX_IMAGE_SIZE=1280
MEMORY_MAX_SPOOF_CROPS=50
MEMORY_AGGRESSIVE_GC=true

# Face detection
DETECTOR_CONF_THRESHOLD=0.75
DETECTOR_NMS_THRESHOLD=0.4
DETECTOR_PAD=10
ATTENDANCE_DETECTION_INTERVAL=1
ATTENDANCE_HEAVY_PROCESS_FACE_THRESHOLD=8
ATTENDANCE_HEAVY_PROCESS_INTERVAL=2
ATTENDANCE_RECOGNITION_CACHE_TTL_FRAMES=8

# Face recognition
RECOGNIZER_THRESHOLD=1.2
RECOGNIZER_KNN_K=5
RECOGNIZER_KNN_VOTING_THRESHOLD=1.2

# Anti-spoofing
ANTISPOOFING_THRESHOLD=0.75

# Dynamic threshold
REC_ENABLE_DYNAMIC_THRESHOLD=True
REC_IDENTITY_QUANTILE=0.8
REC_IDENTITY_MARGIN=0.20
REC_IDENTITY_MIN_SCALE=0.7

# TTA
TTA_ENABLED=False

# Calibrated confidence
REC_CONFIDENCE_DISTANCE_WEIGHT=0.3
REC_CONFIDENCE_VOTE_WEIGHT=0.7

# Recognition filtering
REC_MIN_CONFIDENCE=0.5
REC_MIN_VOTE_RATIO=0.7
REC_MIN_VALID_NEIGHBORS_RATIO=0.7
REC_REQUIRE_STABLE=False
REC_MAX_DISTANCE_RATIO=0.95

# Recognition validation
RECOGNITION_CONFIRMATION_THRESHOLD=3
RECOGNITION_WINDOW_SIZE=5
RECOGNITION_MIN_FRAME_SUCCESS_RATE=0.60
RECOGNITION_DEBOUNCE_SECONDS=30
RECOGNITION_AUTO_ADJUST_TO_FPS=False
RECOGNITION_TARGET_FPS=5

# RAG
RAG_BI_ENCODER_MODEL=bkai-foundation-models/vietnamese-bi-encoder
