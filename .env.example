# =============================================================================

# App settings
APP_NAME=AI-Service
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
ACCESS_LOG=False
ENVIRONMENT=development

# Server settings
HOST=0.0.0.0
PORT=8069

# -------------------------
# Backend Integration (Báº®T BUá»˜C)
# Must match Backend SECRET_KEY and AI_SERVICE_SECRET
# -------------------------
BACKEND_JWT_SECRET=your-backend-jwt-secret-here
BACKEND_CALLBACK_SECRET=your-backend-ai-service-secret-here


# -------------------------
# Model Paths (Äiá»n Ä‘Æ°á»ng dáº«n Ä‘áº¿n model trÃªn mÃ¡y)
# -------------------------
EMBEDDING_DIR=
DETECTOR_CHECKPOINT=/path/to/best_yolov3_widerface.pth
RECOGNIZER_CHECKPOINT=/path/to/model_ir_se50.pth
ANTISPOOFING_CHECKPOINT=/path/to/checkpoint.pt

# -------------------------
# Model Device settings
# -------------------------
MODEL_DEVICE=cuda
ANTISPOOFING_DEVICE=cuda

# -------------------------
# Attendance Stream (Optional)
# -------------------------
ATTENDANCE_HEAVY_PROCESS_FACE_THRESHOLD=8
ATTENDANCE_HEAVY_PROCESS_INTERVAL=3
ATTENDANCE_RECOGNITION_CACHE_TTL_FRAMES=8

# -------------------------
# Memory Optimization (TÃ¹y chá»n)
# -------------------------
MEMORY_GPU_THRESHOLD=0.85
MEMORY_CLEANUP_INTERVAL=50
MEMORY_MAX_FACES_PER_FRAME=10
MEMORY_MAX_IMAGE_SIZE=1280
MEMORY_MAX_SPOOF_CROPS=50
MEMORY_AGGRESSIVE_GC=true

# RAG Settings
RAG_BI_ENCODER_MODEL=bkai-foundation-models/vietnamese-bi-encoder
